{
  "name": "ai-native-sdlc-harness",
  "private": true,
  "version": "0.1.0",
  "description": "把 Anthropic 的 AI 原生 SDLC 方法论落成 DeepSeek Harness 插件",
  "license": "MIT",
  "author": "HMYDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HMYDK/ai-native-sdlc-dsh.git"
  },
  "homepage": "https://github.com/HMYDK/ai-native-sdlc-dsh#readme",
  "bugs": {
    "url": "https://github.com/HMYDK/ai-native-sdlc-dsh/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "compat": "node tools/compat-check.mjs",
    "preset-sync": "node tools/preset-sync-check.mjs",
    "preset-sync:write": "node tools/preset-sync-check.mjs --write"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "semver": "^7.7.0"
  }
}
