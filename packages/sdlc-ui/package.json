{
  "name": "@ai-native-sdlc/dsh-sdlc-ui",
  "version": "0.1.0",
  "private": false,
  "description": "Panel for the AI-native SDLC on DeepSeek Harness: the task board, its artifact chain and its verdicts, visible instead of grepped.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "!lib/**/*.test.js",
    "!lib/**/*.d.ts",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sdlc",
    "client",
    "panel",
    "dashboard"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/client.js','lib/client.js')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node smoke.mjs",
    "test": "node smoke.mjs && node board.test.mjs"
  }
}
