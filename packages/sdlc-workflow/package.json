{
  "name": "@ai-native-sdlc/dsh-sdlc-workflow",
  "version": "0.1.1",
  "private": false,
  "description": "The AI-native SDLC workflow itself, shipped as a Skill: what makes an artifact useful (not merely structurally complete), how to write falsifiable acceptance criteria, and the questions a verifier must put to the author.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "!lib/**/*.test.js",
    "!lib/**/*.d.ts",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sdlc",
    "skill",
    "workflow",
    "verification"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test lib/*.test.js",
    "smoke": "ELECTRON_RUN_AS_NODE=1 \"$DSH_APP/Contents/MacOS/DeepSeek Harness\" --expose-internals smoke.mjs",
    "verify": "npm run build && npm run test && npm run smoke"
  }
}
