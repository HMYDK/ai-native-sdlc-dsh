{
  "name": "@ai-native-sdlc-plugin/dsh-sdlc",
  "version": "0.6.0",
  "private": false,
  "author": "HMYDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HMYDK/ai-native-sdlc-dsh.git",
    "directory": "packages/sdlc"
  },
  "homepage": "https://github.com/HMYDK/ai-native-sdlc-dsh#readme",
  "bugs": {
    "url": "https://github.com/HMYDK/ai-native-sdlc-dsh/issues"
  },
  "description": "The AI-native SDLC as one DeepSeek Harness bundle: a suite-level UI host row plus one Agent Preset (\"AI 原生 SDLC\") that mounts the six mechanism components only in sessions that explicitly select it.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./task": "./lib/task/index.js",
    "./artifact": "./lib/artifact/index.js",
    "./verify": "./lib/verify/index.js",
    "./verify/preset-filter": "./lib/verify/preset-filter.js",
    "./verify/recording": "./lib/verify/recording.js",
    "./status": "./lib/status/index.js",
    "./workflow": "./lib/workflow/index.js",
    "./ui": "./lib/ui/index.js",
    "./client": "./lib/ui/client.js",
    "./rsi": "./lib/rsi/index.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./*/locale/en.json": "./locale/*/en.json",
    "./*/locale/zh.json": "./locale/*/zh.json",
    "./*/icon": "./icons/*.svg"
  },
  "files": [
    "lib/**/*.js",
    "!lib/**/*.test.js",
    "!lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/**/*.json",
    "icon.svg",
    "README.md",
    "TASK.md",
    "RSI.md",
    "icons/*.svg",
    "THIRD_PARTY_NOTICES.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-agent-preset": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/js-yaml": "^4.0.9"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sdlc",
    "verification",
    "artifact-chain"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/ui/client.js','lib/ui/client.js')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"lib/**/*.test.js\" && node test/board.test.mjs && node --test test/client.test.mjs",
    "smoke": "ELECTRON_RUN_AS_NODE=1 \"$DSH_APP/Contents/MacOS/DeepSeek Harness\" --expose-internals smoke/run-all.mjs",
    "verify": "npm run build && npm run test && npm run smoke",
    "mutation-gate": "node ../../tools/mutation-score.mjs --gate sdlc"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    }
  }
}
