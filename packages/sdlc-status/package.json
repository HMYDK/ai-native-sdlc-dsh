{
  "name": "@ai-native-sdlc/dsh-sdlc-status",
  "version": "0.1.2",
  "private": false,
  "description": "Portfolio view for an AI-native SDLC on DeepSeek Harness: one call lists every task's status, artifact completeness, missing pieces and latest verdict.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/**/*.js",
    "!lib/**/*.test.js",
    "!lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/js-yaml": "^4.0.9"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sdlc",
    "status",
    "artifact-chain",
    "dashboard"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test lib/*.test.js",
    "smoke": "ELECTRON_RUN_AS_NODE=1 \"$DSH_APP/Contents/MacOS/DeepSeek Harness\" --expose-internals smoke.mjs",
    "verify": "npm run build && npm run test && npm run smoke",
    "mutation-gate": "node ../../tools/mutation-score.mjs --gate sdlc-status"
  }
}
