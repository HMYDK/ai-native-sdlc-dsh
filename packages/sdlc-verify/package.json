{
  "name": "@ai-native-sdlc/dsh-sdlc-verify",
  "version": "0.1.3",
  "private": false,
  "description": "Independent verification for an AI-native SDLC on DeepSeek Harness: a verifier that is never the actor, plus a test-freeze gate.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./recording": {
      "types": "./lib/recording.d.ts",
      "default": "./lib/recording.js"
    },
    "./preset-filter": {
      "types": "./lib/preset-filter.d.ts",
      "default": "./lib/preset-filter.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "!lib/**/*.test.js",
    "!lib/**/*.test.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/js-yaml": "^4.0.9",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sdlc",
    "verification"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test lib/*.test.js",
    "smoke": "ELECTRON_RUN_AS_NODE=1 \"$DSH_APP/Contents/MacOS/DeepSeek Harness\" --expose-internals smoke.mjs",
    "verify": "npm run build && npm run test && npm run smoke",
    "mutation-gate": "node ../../tools/mutation-score.mjs --gate sdlc-verify"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
