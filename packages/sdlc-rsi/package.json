{
  "name": "@ai-native-sdlc/dsh-sdlc-rsi",
  "version": "0.1.0",
  "description": "Learn from real verification runs through durable evidence and controlled experiments.",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./package.json": "./package.json" },
